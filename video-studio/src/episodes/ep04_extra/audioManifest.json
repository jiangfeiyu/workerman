      "durationSec": 14.348,
      "cues": [
        {
          "startSec": 0.1,
          "endSec": 13.798,
          "text": "TIME_WAIT 守候 2MSL：1. 兜底重传最后一个 ACK；2. 等待迷途旧报文彻底消散"
        }
      ]
    },
