      "cues": [
        {
          "startSec": 0.04,
          "endSec": 3.66,
          "text": "看实测输出：第 1 轮切出 id=1 后"
        },
        {
          "startSec": 3.66,
          "endSec": 8.703,
          "text": "第 2 条那 10 字节半截安稳留在蓄水池里等下一波水"
        },
        {
          "startSec": 8.703,
          "endSec": 15.495,
          "text": "第 2 轮水一到，立刻精准拼接还原出 id=2 和 id=3，蓄水池归零！"
        },
        {
          "startSec": 15.495,
