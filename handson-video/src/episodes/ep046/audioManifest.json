          "endSec": 16.025,
          "text": "我们在 Request::isKeepAlive() 里检查 Connection 头"
        },
        {
          "startSec": 16.025,
          "endSec": 19.102,
          "text": "只要不是 close 就保留连接不关闭！"
        }
      ]
