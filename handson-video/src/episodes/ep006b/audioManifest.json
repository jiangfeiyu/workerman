      "cues": [
        {
          "startSec": 0.04,
          "endSec": 4.584,
          "text": "看第 24 和 27 行的真实执行顺序：当 5 号门响了"
        },
        {
          "startSec": 4.584,
          "endSec": 10.274,
          "text": "查表取出函数加括号一触发，onGateRing 才真正运行"
        },
        {
          "startSec": 10.274,
          "endSec": 15.009,
          "text": "并且顺手把 onGuestSpeak 放进 6 号抽屉"
        },
        {
          "startSec": 15.009,
          "endSec": 19.477,
          "text": "接着 6 号客人说话时，再从 6 号抽屉拿出来触发！"
        },
        {
          "startSec": 19.477,
