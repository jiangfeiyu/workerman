      "cues": [
        {
          "startSec": 0.04,
          "endSec": 5.158,
          "text": "核心代码只有三行！用 Fiber::getCurrent() 抓住自己"
        },
        {
          "startSec": 5.158,
          "endSec": 13.266,
          "text": "调一句 $loop->delay($seconds, fn() => $fiber->resume()) 订个到点唤醒的闹钟"
        },
        {
          "startSec": 13.266,
          "endSec": 17.154,
          "text": "然后立刻 Fiber::suspend() 让出控制权！"
        },
        {
          "startSec": 17.154,
