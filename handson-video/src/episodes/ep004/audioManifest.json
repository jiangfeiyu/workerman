          "endSec": 11.222,
          "text": "每轮循环先拷贝 $read = [$server]"
        },
        {
          "startSec": 11.222,
          "endSec": 18.405,
          "text": "然后调用 @stream_select($read, $write, $except, null)"
        },
        {
          "startSec": 18.405,
          "endSec": 20.743,
          "text": "注意第 4 个参数传 null"
        },
        {
          "startSec": 20.743,
          "endSec": 25.246,
          "text": "意思是没客人时无限期安心睡眠，CPU 占用直接归零！"
        }
      ]
    },
