      "durationSec": 22.294,
      "cues": [
        {
          "startSec": 0.04,
          "endSec": 8.264,
          "text": "解药必须把事件对象强引用存进类的属性数组 $this->allEvents[$fd] = $ev 里保活！"
        },
        {
          "startSec": 8.264,
          "endSec": 13.83,
          "text": "一直等到连接断开调 del($fd) 时才主动 unset 精准释放！"
        },
        {
          "startSec": 13.83,
          "endSec": 18.58,
          "text": "实测存入后 destroyedDelta=0 稳如泰山"
        },
        {
          "startSec": 18.58,
          "endSec": 21.694,
          "text": "del 之后才彻底回收零内存泄漏！"
