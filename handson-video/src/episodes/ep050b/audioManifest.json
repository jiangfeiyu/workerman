      "cues": [
        {
          "startSec": 0.04,
          "endSec": 5.105,
          "text": "第二，看右下角的 WebSocket 完整帧地图！"
        },
        {
          "startSec": 5.105,
          "endSec": 10.875,
          "text": "前 2 字节永远是 B0 和 B1；如果长度码是 126 或 127"
        },
        {
          "startSec": 10.875,
          "endSec": 14.777,
          "text": "紧跟着就是 2 字节或 8 字节的扩展长度"
        },
        {
          "startSec": 14.777,
          "endSec": 18.472,
          "text": "再往后才排着 4 字节 MaskKey"
        },
        {
          "startSec": 18.472,
          "endSec": 22.997,
          "text": "最后才是 Payload 正文！看清这张地图"
        },
        {
          "startSec": 22.997,
