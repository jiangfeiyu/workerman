      "cues": [
        {
          "startSec": 0.04,
          "endSec": 5.038,
          "text": "看 EP051 阶梯长度和 EP052 掩码解密之前"
        },
        {
          "startSec": 5.038,
          "endSec": 9.406,
          "text": "先把两个容易看懵的二进制细节铺平！第一"
        },
        {
          "startSec": 9.406,
          "endSec": 14.194,
          "text": "我们在 EP038 学过 4 字节大端序字母大写 N"
        },
        {
          "startSec": 14.194,
          "endSec": 17.302,
          "text": "WebSocket 用得更省"
        },
        {
          "startSec": 17.302,
          "endSec": 21.46,
          "text": "字母小写 n 代表 2 字节 16 位无符号整数"
        },
        {
          "startSec": 21.46,
          "endSec": 25.774,
          "text": "字母大写 J 代表 8 字节 64 位无符号整数！"
        }
      ]
    },
    "shot-02-unpack-index": {
      "id": "shot-02-unpack-index",
      "audioFile": "audio/ep050b/shot-02-unpack-index.mp3",
      "durationSec": 17.038,
      "cues": [
        {
          "startSec": 0.04,
          "endSec": 2.917,
          "text": "还要注意一个 PHP 经典小坑"
        },
        {
          "startSec": 2.917,
          "endSec": 7.155,
          "text": "第 9 行写 unpack('n', ...) 时"
        },
        {
          "startSec": 7.155,
          "endSec": 9.449,
          "text": "因为格式里没起字段名"
        },
        {
          "startSec": 9.449,
          "endSec": 13.22,
          "text": "返回的数组下标不是 0 而是从 1 开始的！"
        },
        {
          "startSec": 13.22,
          "endSec": 16.438,
          "text": "所以代码里取长度必须写 [1]！"
        }
      ]
    },
    "shot-03-frame-map": {
      "id": "shot-03-frame-map",
      "audioFile": "audio/ep050b/shot-03-frame-map.mp3",
