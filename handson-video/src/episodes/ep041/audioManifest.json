  "shots": {
    "shot-01-raw-http": {
      "id": "shot-01-raw-http",
      "audioFile": "audio/ep041/shot-01-raw-http.mp3",
      "durationSec": 30.166,
      "cues": [
        {
          "startSec": 0.04,
          "endSec": 4.388,
          "text": "很多人觉得手写 HTTP 协议高不可攀"
        },
        {
          "startSec": 4.388,
          "endSec": 9.633,
          "text": "其实 HTTP 也是跑在 TCP 之上的纯文本协议！"
        },
        {
          "startSec": 9.633,
          "endSec": 12.95,
          "text": "当浏览器连上我们的服务器时"
        },
        {
          "startSec": 12.95,
          "endSec": 18.957,
          "text": "它发过来的无非是一段按 \\r\\n 回车换行分隔的字符串"
        },
        {
          "startSec": 18.957,
          "endSec": 23.395,
          "text": "第一行请求行，中间几行 Headers"
        },
        {
          "startSec": 23.395,
          "endSec": 29.566,
          "text": "再加一个空行 \\r\\n\\r\\n，后面紧跟 Body 正文！"
        }
      ]
    },
    "shot-02-map-interface": {
      "id": "shot-02-map-interface",
      "audioFile": "audio/ep041/shot-02-map-interface.mp3",
      "durationSec": 23.398,
      "cues": [
        {
          "startSec": 0.04,
          "endSec": 1.583,
          "text": "看透了这个结构"
        },
        {
          "startSec": 1.583,
          "endSec": 6.914,
          "text": "立刻就能把它塞进我们的 ProtocolInterface！"
        },
        {
          "startSec": 6.914,
          "endSec": 11.789,
          "text": "input() 负责找空行 \\r\\n\\r\\n 加上 Body 长度"
        },
        {
          "startSec": 11.789,
          "endSec": 15.086,
          "text": "decode() 拆出 Request 对象"
        },
        {
          "startSec": 15.086,
          "endSec": 19.365,
          "text": "encode() 把 Response 拼回标准响应头！"
        },
        {
          "startSec": 19.365,
          "endSec": 22.798,
          "text": "下一集 EP042 先写 GET 边界判断！"
        }
      ]
    }
  }
}
