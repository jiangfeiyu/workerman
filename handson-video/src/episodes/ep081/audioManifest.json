        {
          "startSec": 0.04,
          "endSec": 7.156,
          "text": "救星是在 flags 参数加上 STREAM_CLIENT_ASYNC_CONNECT！"
        },
        {
          "startSec": 7.156,
          "endSec": 10.84,
          "text": "一毫秒发出 SYN 包立刻返回非阻塞句柄！"
