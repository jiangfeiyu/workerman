        {
          "startSec": 0.04,
          "endSec": 4.883,
          "text": "今天用上集理清的平铺思维，不建类直接改造 EP005！"
        },
        {
          "startSec": 4.883,
          "endSec": 8.736,
          "text": "先建两张同下标的表：readFds 存资源"
        },
        {
          "startSec": 8.736,
          "endSec": 13.296,
          "text": "readCallbacks 存处理函数。为了不绕晕"
        },
        {
          "startSec": 13.296,
          "endSec": 19.624,
          "text": "watchRead 和 unwatchRead 直接写成最普通的 PHP 函数"
        },
        {
          "startSec": 19.624,
          "endSec": 21.67,
          "text": "再也不搞闭包套闭包！"
        }
      ]
    },
    "shot-02-register-handlers": {
