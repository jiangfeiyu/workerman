      "audioFile": "audio/ep007/shot-02-register-handlers.mp3",
      "durationSec": 23.974,
      "cues": [
        {
          "startSec": 0.04,
          "endSec": 2.667,
          "text": "看第 28 到 49 行的平铺写法！"
        },
        {
          "startSec": 2.667,
          "endSec": 7.41,
          "text": "我们先在外面写好客人说话回调 onClientRead"
        },
        {
          "startSec": 7.41,
          "endSec": 10.788,
          "text": "再单独写门卫迎客回调 onAccept"
        },
        {
          "startSec": 10.788,
          "endSec": 18.192,
          "text": "迎到新客后只用一行 watchRead($conn, $onClientRead) 完成登记！"
        },
        {
          "startSec": 18.192,
          "endSec": 21.058,
          "text": "最后第 49 行把门卫挂进 5 号抽屉"
        },
        {
          "startSec": 21.058,
          "endSec": 23.374,
          "text": "此时两段代码都还没执行！"
        }
      ]
    },
