      "cues": [
        {
          "startSec": 0.04,
          "endSec": 3.214,
          "text": "看第 36 到 45 行！每次客户端收走一批数据"
        },
        {
          "startSec": 3.214,
          "endSec": 7.416,
          "text": "内核发送缓冲腾出空位，onWritable 就触发一次"
        },
        {
          "startSec": 7.416,
          "endSec": 12.978,
          "text": "调用 fwrite($s, $pending) 拿到实际写入字节数 $written"
        },
        {
          "startSec": 12.978,
          "endSec": 18.328,
          "text": "再用 substr($pending, $written) 把发完的头部切掉！"
        },
        {
          "startSec": 18.328,
          "endSec": 23.254,
          "text": "一直切到 $pending 为空，立刻调 offWritable() 卸载！"
        }
      ]
    },
